{
  "name": "trofico-sales-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && npm run api:build && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.api.config.ts",
    "api:build": "tsc -p backend/tsconfig.json",
    "api:dev": "tsx --tsconfig backend/tsconfig.json watch backend/src/main.ts",
    "api:start": "node backend/dist/main.js",
    "test:integration": "npm run api:build && node backend/scripts/run-integration.mjs",
    "test:e2e:api": "playwright test --config playwright.api.config.ts",
    "db:local": "node backend/scripts/local-db.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:test": "node backend/scripts/test-db.mjs",
    "admin:bootstrap": "node backend/dist/cli.js bootstrap",
    "inventory:reconcile": "node backend/dist/cli.js reconcile",
    "sessions:cleanup": "node backend/dist/cli.js cleanup",
    "test:e2e:mock": "playwright test --config playwright.config.ts",
    "start:hostinger": "node server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ma7moud-Mansour/Trofico-Sales-System.git"
  },
