    "react-hook-form": "^7.87.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
