NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sales_runtime:REPLACE@127.0.0.1:5432/sales_dev
MIGRATION_DATABASE_URL=postgresql://sales_owner:REPLACE@127.0.0.1:5432/sales_dev
ALLOWED_ORIGINS=http://localhost:3000
CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
DB_POOL_MAX=10
TRUST_PROXY=none
NEXT_PUBLIC_DATA_MODE=api
API_INTERNAL_URL=http://127.0.0.1:4000
